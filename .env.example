# Local host development defaults use isolated PostgreSQL 54368 and Redis 56368.
DATABASE_URL=postgresql://anibish@127.0.0.1:54368/postgres
REDIS_URL=redis://127.0.0.1:56368
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
API_PORT=3001
HOST=127.0.0.1
PAYMENT_MODE=sandbox
STORAGE_DIR=storage
NEXT_TELEMETRY_DISABLED=1
# Docker/production preparation: generate independent random values. Do not commit.
POSTGRES_PASSWORD=
MFA_ENCRYPTION_KEY=
SANDBOX_PAYMENT_SECRET=
# External SMTP and live payment credentials are intentionally not configured.
