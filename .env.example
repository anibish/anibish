# Local host development defaults use isolated PostgreSQL 54368 and Redis 56368.
DATABASE_URL=postgresql://anibish@127.0.0.1:54368/postgres
REDIS_URL=redis://127.0.0.1:56368
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
API_PORT=3001
HOST=127.0.0.1
PAYMENT_MODE=sandbox
STORAGE_DIR=storage
NEXT_TELEMETRY_DISABLED=1
# Docker/production preparation: generate independent random values. Do not commit.
POSTGRES_PASSWORD=
MFA_ENCRYPTION_KEY=
SANDBOX_PAYMENT_SECRET=
# External SMTP and live payment credentials are intentionally not configured.

# Coolify-specific independent secrets (blank examples only).
ANIBISH_DB_PASSWORD=
ANIBISH_MFA_KEY=
ANIBISH_SANDBOX_SECRET=
# Optional dedicated sender transport; only passed to the worker container.
ANIBISH_SMTP_HOST=
ANIBISH_SMTP_PORT=587
ANIBISH_SMTP_USER=
ANIBISH_SMTP_PASSWORD=

# Keep public until owner MFA and production access gates have passed.
ANIBISH_LAUNCH_STAGE=public

# Private mail transport remains disabled until provider tests pass.
ANIBISH_MAIL_ENABLED=false
ANIBISH_INFO_IMAP_PASSWORD=
ANIBISH_MAIL_IMAP_PASSWORD=

# Dedicated callback receiver secret; never reuse SMTP credentials.
ANIBISH_BREVO_WEBHOOK_TOKEN=
