# Local host development defaults use isolated PostgreSQL 54368 and Redis 56368.
DATABASE_URL=postgresql://anibish@127.0.0.1:54368/postgres
REDIS_URL=redis://127.0.0.1:56368
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
API_PORT=3001
HOST=127.0.0.1
PAYMENT_MODE=sandbox
STORAGE_DIR=storage
NEXT_TELEMETRY_DISABLED=1
# Docker/production preparation: generate independent random values. Do not commit.
POSTGRES_PASSWORD=
MFA_ENCRYPTION_KEY=
SANDBOX_PAYMENT_SECRET=
# External SMTP and live payment credentials are intentionally not configured.

# Coolify-specific independent secrets (blank examples only).
ANIBISH_DB_PASSWORD=
ANIBISH_MFA_KEY=
ANIBISH_SANDBOX_SECRET=
# Optional dedicated sender transport; only passed to the worker container.
ANIBISH_SMTP_HOST=
ANIBISH_SMTP_PORT=587
ANIBISH_SMTP_USER=
ANIBISH_SMTP_PASSWORD=

# Keep public until owner MFA and production access gates have passed.
ANIBISH_LAUNCH_STAGE=public

# Private mail transport remains disabled until provider tests pass.
ANIBISH_MAIL_ENABLED=false
ANIBISH_INFO_IMAP_PASSWORD=
ANIBISH_MAIL_IMAP_PASSWORD=

# Dedicated callback receiver secret; never reuse SMTP credentials.
ANIBISH_BREVO_WEBHOOK_TOKEN=

# Optional local security-event persistence. Production enables it in the dedicated Compose app.
ANIBISH_SECURITY_LOGGING=false
# Set true only after validating the pinned scanner profile and health/preflight.
ANIBISH_CLAMAV_POLICY_CONFIRMED=false

# Optional server-enforced session limits (seconds); background GET polling does not renew idle time.
ANIBISH_SESSION_ABSOLUTE_SECONDS=43200
ANIBISH_STAFF_IDLE_SECONDS=900
ANIBISH_CUSTOMER_IDLE_SECONDS=1800
# Project-file quota defaults. Existing and quarantined records count; no automatic deletion.
ANIBISH_UPLOAD_USER_BYTES=262144000
ANIBISH_UPLOAD_ORG_BYTES=1073741824
ANIBISH_UPLOAD_APP_BYTES=5368709120
ANIBISH_UPLOAD_USER_COUNT=200
ANIBISH_UPLOAD_ORG_COUNT=1000
ANIBISH_UPLOAD_APP_COUNT=10000
ANIBISH_UPLOAD_MIN_FREE_BYTES=5368709120
ANIBISH_UPLOAD_CONCURRENCY=2
